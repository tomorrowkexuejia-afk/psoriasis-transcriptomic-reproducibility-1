^SERIES = GSE201827
!Series_title = Psoriasis Improvements and Inflammatory Biomarker Normalization With Secukinumab: The Randomized ObePso-S Study 
!Series_geo_accession = GSE201827
!Series_status = Public on Mar 24 2023
!Series_submission_date = Apr 28 2022
!Series_last_update_date = Apr 15 2026
!Series_pubmed_id = 36690571
!Series_summary = To investigate treatment effects of secukinumab on clinical signs and psoriatic inflammation markers over 52 weeks in patients with psoriasis.
!Series_overall_design = Patients with psoriasis were randomized 2:1 to receive secukinumab 300 mg (n=54) or placebo (n=28), stratified by body weight (<90 or ≥90 kg), for 52 weeks. At Week 12, patients receiving placebo were switched to secukinumab. Gene expression profiles were evaluated in lesional and non-lesional skin biopsies collected at baseline, Week 12, and Week 52.
!Series_type = Expression profiling by array
!Series_contributor = James,G,Krueger
!Series_contributor = Andrew,,Blauvelt
!Series_contributor = Sandra,,Garcet
