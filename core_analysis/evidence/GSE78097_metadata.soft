^SERIES = GSE78097
!Series_title = The spectrum of mild-to-severe psoriasis vulgaris is defined by a common activation of IL-17 pathway genes, but with key differences in immune regulatory genes
!Series_geo_accession = GSE78097
!Series_status = Public on Feb 19 2017
!Series_submission_date = Feb 19 2016
!Series_last_update_date = Jun 13 2023
!Series_pubmed_id = 27185339
!Series_summary = Mild vs. severe psoriasis vulgaris is often distinguished by the Psoriasis Area and Severity Index. It is widely assumed that severe psoriasis involves higher levels of skin inflammation, but comparative molecular profiles of mild vs. severe disease have not been previously performed. In this study, we used gene arrays to phenotype North American patients with mild psoriasis vs. severe psoriasis.
!Series_overall_design = 14 mild plaque psoriasis lesional skin biopsy tissues, 13 severe plaque psoriasis lesional skin biopsy tissues, and 6 normal skin tissues
!Series_type = Expression profiling by array
!Series_contributor = James,G,Krueger
!Series_contributor = Mayte,,Suárez-Fariñas
!Series_contributor = Jaehwan,,Kim
